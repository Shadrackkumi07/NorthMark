{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.northmarkfacilityservices.com"
        }
      ],
      "destination": "https://northmarkfacilityservices.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/exploring",
      "destination": "/api/serionflow-proxy?sf_path=__serionflow_health_check"
    },
    {
      "source": "/exploring/:sf_path*",
      "destination": "/api/serionflow-proxy?sf_path=:sf_path*"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
